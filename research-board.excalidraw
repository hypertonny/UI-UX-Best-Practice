      "roundness": null,
      "seed": 9050,
      "version": 1,
      "versionNonce": 9051,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "At some point in the day,\nrealizes something has run\nout. Food, medicine, a basic\nitem, doesn't matter when.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At some point in the day,\nrealizes something has run\nout. Food, medicine, a basic\nitem, doesn't matter when.",
      "lineHeight": 1.3,
      "baseline": 11
    },
    {
      "id": "jtext9052",
      "type": "text",
      "x": 202,
