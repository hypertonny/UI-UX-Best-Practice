      "versionNonce": 9075,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Confirms the only real\noption is a 4-6hr, 60km\nround trip. If it's already\nevening, that's not even\ndoable today.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Confirms the only real\noption is a 4-6hr, 60km\nround trip. If it's already\nevening, that's not even\ndoable today.",
      "lineHeight": 1.3,
      "baseline": 11
    },
    {
      "id": "jtext9076",
