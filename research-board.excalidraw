      "versionNonce": 9054,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\"I'll need to sort this out\ntoday.\"",
      "fontSize": 11,
      "fontFamily": 2,
