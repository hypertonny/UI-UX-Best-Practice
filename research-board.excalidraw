      "versionNonce": 9078,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\"Not worth a whole day for\none thing, and today it\nisn't even doable.\"",
      "fontSize": 11,
