    {
      "id": "text1064",
      "type": "text",
      "x": 536,
      "y": 855,
      "width": 428,
      "height": 203,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1065,
      "version": 2,
      "versionNonce": 1978090307,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786297614208,
      "link": null,
      "locked": false,
      "text": "Switched Open -> Hybrid (6 broad categories + Other) after the\nopen version got low real response rate. Only 2 real\nrespondents at time of V1 tree: agreed on 7/20 items outright\n(Group Ordering->Coordinate, Pickup Point->Tracking, Delivery\nETA->Tracking, Cost Splitter->Payments, Order\nHistory->Tracking, Category Tags->Getting Essentials, Payment\nTracker->Payments). Disagreed on the other 13 - too small a\nsample to trust a majority vote, so those were placed by\nfunction/name logic instead and explicitly flagged as a\ndesigner judgment call, not sort-derived. More real\nrespondents pending; will update the tree if new data changes\nthe picture.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Switched Open -> Hybrid (6 broad categories + Other) after the\nopen version got low real response rate. Only 2 real\nrespondents at time of V1 tree: agreed on 7/20 items outright\n(Group Ordering->Coordinate, Pickup Point->Tracking, Delivery\nETA->Tracking, Cost Splitter->Payments, Order\nHistory->Tracking, Category Tags->Getting Essentials, Payment\nTracker->Payments). Disagreed on the other 13 - too small a\nsample to trust a majority vote, so those were placed by\nfunction/name logic instead and explicitly flagged as a\ndesigner judgment call, not sort-derived. More real\nrespondents pending; will update the tree if new data changes\nthe picture.",
      "lineHeight": 1.3,
      "baseline": 13,
      "index": "aL",
      "autoResize": true
    },
