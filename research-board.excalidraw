      "updated": 1786297614208,
      "link": null,
      "locked": false,
      "text": "How I'm doing interviews/observations\n(prof was strict about this)",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How I'm doing interviews/observations\n(prof was strict about this)",
      "lineHeight": 1.3,
      "baseline": 17,
      "index": "a7",
      "autoResize": true
    },
    {
      "id": "text1025",
      "type": "text",
      "x": 16,
      "y": 653,
      "width": 428,
      "height": 135,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1026,
      "version": 2,
      "versionNonce": 526306765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786297614208,
      "link": null,
      "locked": false,
      "text": "Two columns, kept separate, always.\nWHAT I SAW/HEARD - just the facts, zero reading into it. Like\nwatching CCTV footage.\nWHAT I THINK IT MEANS - my own interpretation, written after,\nclearly marked as mine.\nProf's exact point: if the observation log is sloppy,\neverything after it (persona, empathy map, pain point) is\nsloppy too.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two columns, kept separate, always.\nWHAT I SAW/HEARD - just the facts, zero reading into it. Like\nwatching CCTV footage.\nWHAT I THINK IT MEANS - my own interpretation, written after,\nclearly marked as mine.\nProf's exact point: if the observation log is sloppy,\neverything after it (persona, empathy map, pain point) is\nsloppy too.",
      "lineHeight": 1.3,
      "baseline": 13,
      "index": "a8",
      "autoResize": true
    },
